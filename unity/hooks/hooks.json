{
  "description": "AGENT_LOOP_HOME 내보내기, 조각 검사를 통과하지 않은 트리의 git push 막기(루프 저장소의 task/* 브랜치에서만), PR 뒤 CI 실행기 확인(.agent-loop/config.json에 runner.task가 있을 때만)",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {"type": "command", "command": "python -I \"${CLAUDE_PLUGIN_ROOT}/scripts/session_env.py\"", "timeout": 10}
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {"type": "command", "command": "python -I \"${CLAUDE_PLUGIN_ROOT}/scripts/slice_check.py\" guard", "timeout": 60}
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {"type": "command", "command": "python -I \"${CLAUDE_PLUGIN_ROOT}/scripts/ensure_runner.py\"", "timeout": 90, "statusMessage": "CI 실행기 상태 확인"}
        ]
      }
    ]
  }
}
